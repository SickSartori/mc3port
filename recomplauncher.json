{
  "$schema": "https://recomplauncher.com/schema/recomplauncher.json",
  "format": 1,
  "name": "mc3port",
  "game": {
    "kind": "iso",
    "label": "Your disc image (.iso) of Midnight Club 3: DUB Edition Remix, European (PAL) or USA release.",
    "check": { "xdvdfs": "default.xbe" },
    "dumps": [
      { "name": "Midnight Club 3 - DUB Edition Remix (Europe) (En,Fr,De,Es,It)", "size": 7825162240, "crc32": "e0cad5e2" },
      { "name": "Midnight Club 3 - DUB Edition Remix (USA)", "size": 7825162240, "crc32": "a4337b2a" }
    ]
  },
  "start": {
    "program": ["mc3.exe"],
    "args": ["{game}"]
  },
  "saves": ["{install}/xbox_hdd", "{documents}/mc3port/xbox_hdd", "{local}/mc3port/xbox_hdd"],
  "config": [
    {
      "id": "main",
      "format": "ini",
      "file": [
        { "path": "{install}/mc3port.ini", "if": "{install}/portable.txt" },
        { "path": "{install}/mc3port.ini", "if": "{install}/mc3port.ini" },
        { "path": "{documents}/mc3port/mc3port.ini", "if": "{documents}/mc3port/xbox_hdd" },
        { "path": "{documents}/mc3port/mc3port.ini", "if": "{documents}/mc3port/mc3port.ini" },
        { "path": "{local}/mc3port/mc3port.ini", "if": "{local}/mc3port/xbox_hdd" },
        { "path": "{local}/mc3port/mc3port.ini", "if": "{local}/mc3port/mc3port.ini" },
        { "path": "{documents}/mc3port/mc3port.ini" }
      ],
      "game_path": "disc_image"
    }
  ],
  "settings": [
    {
      "id": "window",
      "label": "Window",
      "help": "Full screen (without a border, so Alt+Tab is instant) or a window. Big Picture mode always starts full screen.",
      "choices": [
        { "label": "Windowed", "set": { "fullscreen": "0" } },
        { "label": "Fullscreen", "set": { "fullscreen": "1" } }
      ],
      "defaults": { "fullscreen": "0" }
    },
    {
      "id": "vsync",
      "label": "V-Sync",
      "help": "The picture never tears; on a slow PC the game may drop to 30 fps.",
      "choices": [
        { "label": "Off", "set": { "vsync": "0" } },
        { "label": "On", "set": { "vsync": "1" } }
      ],
      "defaults": { "vsync": "0" }
    },
    {
      "id": "language",
      "label": "Language",
      "help": "The game's language. Automatic follows Windows.",
      "choices": [
        { "label": "Automatic", "set": { "game_language": "0" } },
        { "label": "English", "set": { "game_language": "1" } },
        { "label": "Deutsch", "set": { "game_language": "3" } },
        { "label": "Français", "set": { "game_language": "4" } },
        { "label": "Español", "set": { "game_language": "5" } },
        { "label": "Italiano", "set": { "game_language": "6" } }
      ],
      "defaults": { "game_language": "0" }
    },
    {
      "id": "frame_rate",
      "label": "Frame rate",
      "help": "30 is the Xbox's own; 60 is smoother and needs a PC that handles twice the work; 120 needs a fast processor and a screen of 120 Hz or more.",
      "choices": [
        { "label": "30 fps", "set": { "frame_rate": "30" } },
        { "label": "60 fps", "set": { "frame_rate": "60" } },
        { "label": "120 fps", "set": { "frame_rate": "120" } }
      ],
      "defaults": { "frame_rate": "60" }
    },
    {
      "id": "resolution",
      "label": "Resolution",
      "help": "What the game draws at: higher is smoother and costs more.",
      "choices": [
        { "label": "Like the screen", "set": { "render_scale": "0" } },
        { "label": "480p (Xbox)", "set": { "render_scale": "1" } },
        { "label": "720p", "set": { "render_scale": "1.5" } },
        { "label": "1080p", "set": { "render_scale": "2.25" } },
        { "label": "1440p", "set": { "render_scale": "3" } },
        { "label": "4K", "set": { "render_scale": "4.5" } },
        { "label": "5K", "set": { "render_scale": "6" } }
      ],
      "defaults": { "render_scale": "0" }
    },
    {
      "id": "picture",
      "label": "Picture",
      "help": "The game's own widescreen mode (wider view, no black bars); 21:9 takes the shape of a screen wider than 16:9 (films and loading screens stay 16:9); or 4:3 like a classic TV.",
      "choices": [
        { "label": "16:9", "set": { "widescreen": "1" } },
        { "label": "21:9", "set": { "widescreen": "2" } },
        { "label": "4:3", "set": { "widescreen": "0" } }
      ],
      "defaults": { "widescreen": "1" }
    },
    {
      "id": "field_of_view",
      "label": "Field of view",
      "help": "How wide the camera sees: 100% is the game's own.",
      "choices": [
        { "label": "75%", "set": { "field_of_view": "75" } },
        { "label": "90%", "set": { "field_of_view": "90" } },
        { "label": "100%", "set": { "field_of_view": "100" } },
        { "label": "115%", "set": { "field_of_view": "115" } },
        { "label": "130%", "set": { "field_of_view": "130" } }
      ],
      "defaults": { "field_of_view": "100" }
    },
    {
      "id": "texture_filter",
      "label": "Texture filter",
      "help": "Anisotropic filtering: roads and walls stay sharp at a slant. 16x costs little on any graphics card.",
      "choices": [
        { "label": "Off", "set": { "anisotropy": "1" } },
        { "label": "4x", "set": { "anisotropy": "4" } },
        { "label": "8x", "set": { "anisotropy": "8" } },
        { "label": "16x", "set": { "anisotropy": "16" } }
      ],
      "defaults": { "anisotropy": "16" }
    },
    {
      "id": "sharp_textures",
      "label": "Sharp textures",
      "help": "The textures of roads, buildings and cars enlarged with their edges kept, for when you see them from close. They take more graphics memory and sharpen a few seconds after a place loads.",
      "choices": [
        { "label": "Off", "set": { "sharp_textures": "0" } },
        { "label": "On", "set": { "sharp_textures": "1" } }
      ],
      "defaults": { "sharp_textures": "0" }
    },
    {
      "id": "modern_effects",
      "label": "Modern effects",
      "help": "Glow, sharpening, colour, vignette and ambient occlusion; F10 switches them while playing.",
      "choices": [
        { "label": "On", "set": { "effects": "1" } },
        { "label": "Off", "set": { "effects": "0" } }
      ],
      "defaults": { "effects": "1" }
    },
    {
      "id": "frame_counter",
      "label": "Frame counter",
      "help": "Frames per second in a corner while playing.",
      "choices": [
        { "label": "Off", "set": { "fps_counter": "0" } },
        { "label": "On", "set": { "fps_counter": "1" } }
      ],
      "defaults": { "fps_counter": "0" }
    },
    {
      "id": "hud",
      "label": "HUD",
      "help": "The game's own, or mc3port's with the speedometer, rev counter and gear redrawn sharp at any resolution.",
      "choices": [
        { "label": "The game's", "set": { "hud_style": "0" } },
        { "label": "mc3port's", "set": { "hud_style": "1" } }
      ],
      "defaults": { "hud_style": "1" }
    },
    {
      "id": "speed_units",
      "label": "Speed units",
      "help": "In mc3port's HUD.",
      "choices": [
        { "label": "mph", "set": { "hud_units": "0" } },
        { "label": "km/h", "set": { "hud_units": "1" } }
      ],
      "defaults": { "hud_units": "0" }
    },
    {
      "id": "opening_films",
      "label": "Opening films",
      "help": "The Rockstar logos and the game's intro at start.",
      "choices": [
        { "label": "Skipped", "set": { "skip_intro": "1" } },
        { "label": "Shown", "set": { "skip_intro": "0" } }
      ],
      "defaults": { "skip_intro": "1" }
    },
    {
      "id": "loading_screens",
      "label": "Loading screens",
      "help": "How long they stay at least, to read them; the shortest is 2 seconds.",
      "choices": [
        { "label": "2 seconds", "set": { "loading_screen_seconds": "0" } },
        { "label": "4 seconds", "set": { "loading_screen_seconds": "4" } },
        { "label": "8 seconds", "set": { "loading_screen_seconds": "8" } },
        { "label": "12 seconds", "set": { "loading_screen_seconds": "12" } }
      ],
      "defaults": { "loading_screen_seconds": "0" }
    },
    {
      "id": "loading_music",
      "label": "PS2 loading music",
      "help": "The PS2 version's loading-screen music, from your own WAV files (1.wav to 18.wav in the loading_music folder; docs/loading_music/README.md says how). Longer loading screens give it time to play.",
      "choices": [
        { "label": "On", "set": { "loading_music": "1" } },
        { "label": "Off", "set": { "loading_music": "0" } }
      ],
      "defaults": { "loading_music": "1" }
    },
    {
      "id": "loading_music_volume",
      "label": "Loading music volume",
      "help": "The PS2 loading music's own volume; it also follows the overall volume.",
      "choices": [
        { "label": "100", "set": { "loading_music_volume": "100" } },
        { "label": "70", "set": { "loading_music_volume": "70" } },
        { "label": "50", "set": { "loading_music_volume": "50" } },
        { "label": "25", "set": { "loading_music_volume": "25" } }
      ],
      "defaults": { "loading_music_volume": "70" }
    },
    {
      "id": "volume",
      "label": "Volume",
      "help": "Overall volume; 100 is the loudest.",
      "choices": [
        { "label": "100", "set": { "volume": "100" } },
        { "label": "75", "set": { "volume": "75" } },
        { "label": "50", "set": { "volume": "50" } },
        { "label": "25", "set": { "volume": "25" } }
      ],
      "defaults": { "volume": "100" }
    }
  ],
  "folders": {
    "saves": [
      { "path": "{install}/xbox_hdd", "if": "{install}/portable.txt" },
      { "path": "{install}/xbox_hdd", "if": "{install}/mc3port.ini" },
      { "path": "{documents}/mc3port/xbox_hdd", "if": "{documents}/mc3port/xbox_hdd" },
      { "path": "{documents}/mc3port/xbox_hdd", "if": "{documents}/mc3port/mc3port.ini" },
      { "path": "{local}/mc3port/xbox_hdd", "if": "{local}/mc3port/xbox_hdd" },
      { "path": "{local}/mc3port/xbox_hdd", "if": "{local}/mc3port/mc3port.ini" },
      { "path": "{documents}/mc3port/xbox_hdd" }
    ],
    "logs": [
      { "path": "{install}/logs", "if": "{install}/portable.txt" },
      { "path": "{install}/logs", "if": "{install}/mc3port.ini" },
      { "path": "{documents}/mc3port/logs", "if": "{documents}/mc3port/xbox_hdd" },
      { "path": "{documents}/mc3port/logs", "if": "{documents}/mc3port/mc3port.ini" },
      { "path": "{local}/mc3port/logs", "if": "{local}/mc3port/xbox_hdd" },
      { "path": "{local}/mc3port/logs", "if": "{local}/mc3port/mc3port.ini" },
      { "path": "{documents}/mc3port/logs" }
    ]
  },
  "exit_codes": {
    "2": "mc3port could not use your disc image: it is missing, incomplete, or another version or region. It needs the European (PAL) or USA release of Midnight Club 3: DUB Edition Remix, as a complete .iso: pick it again on the game's page.",
    "3": "mc3port could not start Direct3D 11, which it needs to draw the game. Update the graphics driver; on Linux, install the 32-bit Vulkan and OpenGL libraries (see the README, Linux)."
  }
}
